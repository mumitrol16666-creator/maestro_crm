WHATSAPP_BROWSER_CRM_URL=http://127.0.0.1:5000
WHATSAPP_BROWSER_WORKER_SECRET=change-me-separate-worker-secret
WHATSAPP_BROWSER_ACCOUNT_KEY=maestro-main
WHATSAPP_BROWSER_WORKER_ID=maestro-playwright-1
WHATSAPP_SESSION_PATH=../../sessions/whatsapp
WHATSAPP_BROWSER_HEADLESS=false
# WhatsApp отклоняет служебный HeadlessChrome user-agent даже у нового Chromium.
WHATSAPP_BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.7922.34 Safari/537.36
WHATSAPP_BROWSER_POLL_INTERVAL_MS=5000
WHATSAPP_BROWSER_MODE=observer

# false безопаснее: worker читает только уже открытый оператором диалог.
# true разрешает открывать непрочитанные чаты, что помечает их прочитанными.
WHATSAPP_BROWSER_OPEN_UNREAD_CHATS=false
