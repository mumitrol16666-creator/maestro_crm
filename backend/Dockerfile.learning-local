FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.learning-local.config.ts ./prisma.learning-local.config.ts
COPY src ./src
COPY scripts ./scripts

RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build \
    npx prisma generate --config=prisma.learning-local.config.ts

EXPOSE 5000

CMD ["sh", "-c", "npx prisma db push --config=prisma.learning-local.config.ts && node src/server.js"]
